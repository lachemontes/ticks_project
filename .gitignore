*.fastq
*.fastq.gz
*.fq
*.fq.gz
*_val_1.fq.gz
*_val_2.fq.gz
*_trimming_report.txt

# ── Alignments ───────────────────────────────────────────────
*.sam
*.bam
*.bam.bai
*.bai
*.cram
*.crai

# ── Sequence files and indices ───────────────────────────────
*.fasta
*.fa
*.fna
*.faa
*.pep
*.cds
*.fai
*.idx
*.h5
*.2bit

